<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mhhemati0.WebArchive</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Web Archive</name>
  <summary>Browse Websites Offline!</summary>
  <description>
    <p>
      Web Archive lets you read websites offline.
      Open downloaded ZIM archives of websites like Wikipedia, Wiktionary, and Stack Exchange, search their contents, and browse them without an internet connection.
      You can also find and download new archives from the Kiwix library.
    </p>
    <p>
      Browse the contents of your ZIM files, search inside them, and open
      them just like the original web pages. You can also browse the Kiwix
      library catalog from within the app and download new archives directly
      to your ZIMs folder.
    </p>
  </description>

  <developer id="io.github.mhhemati0">
    <name>mhhemati0</name>
  </developer>
    <branding>
    <color type="primary" scheme_preference="light">#3584E4</color>
    <color type="primary" scheme_preference="dark">#1C71D8</color>
  </branding>
  <url type="homepage">https://github.com/mhhemati0/WebArchive</url>
  <url type="bugtracker">https://github.com/mhhemati0/WebArchive/issues</url>

  <translation type="gettext">webarchive</translation>
  <launchable type="desktop-id">io.github.mhhemati0.WebArchive.desktop</launchable>
  <content_rating type="oars-1.1" />

  <screenshots>
