      <image>https://raw.githubusercontent.com/mhhemati0/WebArchive/main/data/screenshots/img3.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.2.3" date="2026-09-17">
      <description translate="no">
        <p>This update introduces :</p>
        <ul>
          <li>a built in download manager with stop/start download function</li>
          <li>a popup explaining about the app for begginers</li>
          <li>a couple of fixes for the Kiwix Library</li>
        </ul>
      </description>
    </release>
    <release version="1.2.2" date="2026-09-14">
      <description translate="no">
        <p>The app is now mobile ready and optimized for small screens.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-07-31">
      <description translate="no">
        <p>Force the app to check only the ZIMs folder instead of HOME.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-07-30">
      <description translate="no">
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

